{
  "name": "memo",
  "version": "0.1.0",
  "description": "Markdown-based memory system with YAML frontmatter and wikilinks",
  "type": "module",
  "private": false,
  "bin": {
    "memo": "./src/cli.ts"
  },
  "scripts": {
    "prepare": "effect-language-service patch",
    "typecheck": "tsc --noEmit",
    "start": "bun src/cli.ts",
    "test": "rm -rf testing && bun test; status=$?; rm -rf testing; exit $status"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.1",
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@effect/cli": "^0.75.1",
    "@effect/platform-bun": "^0.89.0",
    "@huggingface/transformers": "^4.2.0",
    "@libsql/client": "^0.17.3",
    "effect": "^3.21.2",
    "fuzzysort": "^3.1.0",
    "gray-matter": "^4.0.3",
    "yaml": "^2.9.0"
  }
}
